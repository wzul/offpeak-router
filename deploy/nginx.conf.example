# Example reverse-proxy in front of offpeak-router.
#
# Two things here are not optional:
#
#   1. proxy_buffering off — the router relays Server-Sent Events. With
#      buffering on, nginx holds the response until the last token, so the
#      client sees a stream arrive all at once and streaming is defeated.
#
#   2. The ACME location, if this vhost has no certificate yet. With
#      nginx-proxy's HTTPS_METHOD=nohttps the proxy does not inject its own
#      ACME block, so the challenge must be answered here; otherwise
#      Let's Encrypt gets a 404 and certificate issuance fails.
#
# Authorization is passed through untouched — the router verifies its own
# bearer token and the proxy must neither add nor strip credentials.

server {
    listen 8080;
    server_name _;

    # A long completion can stream for minutes.
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
    proxy_connect_timeout 15s;

    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://host.docker.internal:8788;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_pass_request_headers on;
    }
}
