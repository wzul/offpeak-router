package main

// Ollama dialect for chat: POST /api/chat, POST /api/generate, plus /api/show
// and /api/ps.
//
// The router speaks OpenAI upstream, so these handlers translate in both
// directions: an Ollama request becomes an OpenAI chat payload, and the OpenAI
// answer becomes the Ollama shape (NDJSON when streaming). Provider selection,
// failover, breakers and billing are the same code the /v1 route uses - a client
// must not get different routing just because it used the other dialect.

import (
	"bufio"
	"bytes"
	"context"
	"encoding/base64"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"os"
	"strings"
	"time"
)

type ollamaMessage struct {
	Role      string           `json:"role"`
	Content   string           `json:"content"`
	Images    []string         `json:"images,omitempty"`
	ToolCalls []map[string]any `json:"tool_calls,omitempty"`
}

type ollamaChatRequest struct {
	Model    string          `json:"model"`
	Messages []ollamaMessage `json:"messages"`
	Stream   *bool           `json:"stream"`
	Options  map[string]any  `json:"options"`
	Tools    []map[string]any `json:"tools"`
	System   string          `json:"system"`
	Prompt   string          `json:"prompt"`
	Format   any             `json:"format"`
	KeepAlive any            `json:"keep_alive"`
}

// ollamaStreams reports the stream flag, defaulting to true like Ollama does.
func (o *ollamaChatRequest) streams() bool {
	if o.Stream == nil {
		return true
	}
	return *o.Stream
}

// toOpenAIChat turns either dialect into an OpenAI chat payload.
func (o *ollamaChatRequest) toOpenAIChat(kind string) map[string]any {
	msgs := make([]map[string]any, 0, len(o.Messages)+1)
	if o.System != "" {
		msgs = append(msgs, map[string]any{"role": "system", "content": o.System})
	}
	for _, m := range o.Messages {
		role := m.Role
		if role == "" {
			role = "user"
		}
		if len(m.Images) > 0 && role == "user" {
			// Ollama carries images as bare base64; OpenAI wants a data URL, so the
			// type has to be sniffed or every vision call fails upstream.
			parts := []any{map[string]any{"type": "text", "text": m.Content}}
			for _, img := range m.Images {
				parts = append(parts, map[string]any{
					"type":      "image_url",
					"image_url": map[string]any{"url": imageDataURL(img)},
				})
			}
			msgs = append(msgs, map[string]any{"role": role, "content": parts})
			continue
		}
		entry := map[string]any{"role": role, "content": m.Content}
		if len(m.ToolCalls) > 0 {
			entry["tool_calls"] = m.ToolCalls
		}
		msgs = append(msgs, entry)
	}
	if kind == "generate" {
		// /api/generate has no messages array; the prompt is a single user turn.
		msgs = append(msgs, map[string]any{"role": "user", "content": o.Prompt})
	}

	payload := map[string]any{"messages": msgs}
	if len(o.Tools) > 0 {
		payload["tools"] = o.Tools
	}
	if f, ok := o.Format.(string); ok && f == "json" {
		payload["response_format"] = map[string]any{"type": "json_object"}
	} else if _, ok := o.Format.(map[string]any); ok {
		payload["response_format"] = map[string]any{"type": "json_object"}
	}
	applyOllamaOptions(payload, o.Options)
	return payload
}

// applyOllamaOptions maps the sampling knobs a client actually sets. Unknown
// options are dropped rather than forwarded: an OpenAI upstream rejects foreign
// keys with a 400 and blames the provider.
func applyOllamaOptions(payload map[string]any, opts map[string]any) {
	if len(opts) == 0 {
		return
	}
	pairs := map[string]string{
		"temperature": "temperature",
		"top_p":       "top_p",
		"seed":        "seed",
		"num_predict": "max_tokens",
		"stop":        "stop",
	}
	for from, to := range pairs {
		if v, ok := opts[from]; ok {
			payload[to] = v
		}
	}
}

func imageDataURL(b64 string) string {
	raw, err := base64.StdEncoding.DecodeString(b64)
	mime := "image/jpeg"
	if err == nil && len(raw) > 8 {
		switch {
		case raw[0] == 0x89 && raw[1] == 'P':
			mime = "image/png"
		case raw[0] == 'G' && raw[1] == 'I':
			mime = "image/gif"
		case raw[0] == 'R' && raw[1] == 'I':
			mime = "image/webp"
		}
	}
	return "data:" + mime + ";base64," + b64
}

func handleOllamaChat(w http.ResponseWriter, r *http.Request) {
	handleOllamaTalk(w, r, "chat")
}

func handleOllamaGenerate(w http.ResponseWriter, r *http.Request) {
	handleOllamaTalk(w, r, "generate")
}

func handleOllamaTalk(w http.ResponseWriter, r *http.Request, kind string) {
	var req ollamaChatRequest
	if err := json.NewDecoder(io.LimitReader(r.Body, 32<<20)).Decode(&req); err != nil {
		writeJSON(w, 400, map[string]any{"error": "bad json: " + err.Error()})
		return
	}
	model, ok := resolveModel(req.Model)
	if !ok {
		writeJSON(w, 404, map[string]any{"error": "model " + quoted(req.Model) + " not found, try pulling it first"})
		return
	}
	if api := modelAPI(model); api != APIChat {
		writeJSON(w, 400, map[string]any{"error": model + " is a " + api +
			" model; it is not available on the chat API"})
		return
	}
	payload := req.toOpenAIChat(kind)
	stream := req.streams()

	now := nowFn()
	order := candidateOrder(now, led.Spent(now), model)
	if shadow {
		would := ""
		if len(order) > 0 {
			would = order[0]
		}
		writeJSON(w, 200, map[string]any{"shadow": true, "order": order,
			"would_use": would, "model": model, "dialect": "ollama/" + kind})
		return
	}
	if len(order) == 0 {
		writeJSON(w, 503, map[string]any{"error": "no provider can serve " + model + " right now"})
		return
	}

	var attempts []map[string]string
	anyFailover := false
	for _, name := range order {
		p := provs[name]
		key := os.Getenv(p.KeyEnv)
		if key == "" {
			attempts = append(attempts, map[string]string{"provider": name, "error": "no api key"})
			continue
		}
		if breakerOpen(name) {
			attempts = append(attempts, map[string]string{"provider": name, "error": "circuit open"})
			continue
		}
		if anyFailover {
			w.Header().Set("X-Router-Failover", "true")
		}
		err := renderOllama(w, r, name, p, key, payload, stream, now, model, kind, req.Model)
		if err == nil {
			breakerOK(name)
			return
		}
		logf("provider %s failed (ollama/%s): %v", name, kind, err)
		breakerFail(name)
		anyFailover = true
		attempts = append(attempts, map[string]string{"provider": name, "error": err.Error()})
	}
	writeJSON(w, 502, map[string]any{"error": "all providers failed", "attempts": attempts})
}

// renderOllama performs one upstream call in OpenAI shape and writes the answer
// in Ollama shape. It returns the error untouched before writing anything, so
// the caller can still fail over.
func renderOllama(w http.ResponseWriter, r *http.Request, name string, p *Provider, key string,
	payload map[string]any, stream bool, now time.Time, model, clientModel, kind string) error {

	body := make(map[string]any, len(payload)+2)
	for k, v := range payload {
		body[k] = v
	}
	body["model"] = upstreamModel(name, model)
	body["stream"] = stream
	if stream {
		body["stream_options"] = map[string]any{"include_usage": true}
	}

	buf, err := json.Marshal(body)
	if err != nil {
		return fmt.Errorf("encode body: %w", err)
	}
	req, err := http.NewRequestWithContext(r.Context(), http.MethodPost,
		p.Base+"/chat/completions", bytes.NewReader(buf))
	if err != nil {
		return fmt.Errorf("build request: %w", err)
	}
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Authorization", "Bearer "+key)
	ua := p.UA
	if ua == "" {
		ua = DefaultUserAgent
	}
	req.Header.Set("User-Agent", ua)
	if p.SessionHeader {
		req.Header.Set("x-opencode-session", conversationID(r, body))
	}

	resp, err := httpc.Do(req)
	if err != nil {
		return fmt.Errorf("transport: %w", err)
	}
	defer resp.Body.Close()
	if resp.StatusCode >= 400 {
		detail, _ := io.ReadAll(io.LimitReader(resp.Body, 400))
		return fmt.Errorf("HTTP %d: %s", resp.StatusCode, strings.TrimSpace(string(detail)))
	}

	w.Header().Set("X-Router-Provider", name)
	w.Header().Set("X-Router-Model", model)

	if !stream {
		raw, err := io.ReadAll(resp.Body)
		if err != nil {
			return fmt.Errorf("read body: %w", err)
		}
		var env struct {
			Choices []struct {
				Message struct {
					Content   string           `json:"content"`
					ToolCalls []map[string]any `json:"tool_calls"`
				} `json:"message"`
				FinishReason string `json:"finish_reason"`
			} `json:"choices"`
			Usage *usageBlock `json:"usage"`
		}
		if err := json.Unmarshal(raw, &env); err != nil {
			return fmt.Errorf("decode upstream: %w", err)
		}
		cost := record(name, model, env.Usage, now)
		out := ollamaReply(clientModel, kind)
		if len(env.Choices) > 0 {
			c := env.Choices[0]
			if kind == "generate" {
				out["response"] = c.Message.Content
			} else {
				msg := map[string]any{"role": "assistant", "content": c.Message.Content}
				if len(c.Message.ToolCalls) > 0 {
					msg["tool_calls"] = c.Message.ToolCalls
				}
				out["message"] = msg
			}
			out["done_reason"] = finishToOllama(c.FinishReason)
		}
		out["done"] = true
		if env.Usage != nil {
			out["prompt_eval_count"] = env.Usage.PromptTokens
			out["eval_count"] = env.Usage.CompletionTokens
		}
		w.Header().Set("Content-Type", "application/json")
		w.Header().Set("X-Router-Usd", fmt.Sprintf("%.6f", cost))
		writeJSON(w, 200, out)
		return nil
	}

	w.Header().Set("Content-Type", "application/x-ndjson")
	w.WriteHeader(200)
	flusher, _ := w.(http.Flusher)
	enc := json.NewEncoder(w)

	var captured *usageBlock
	sc := bufio.NewScanner(resp.Body)
	sc.Buffer(make([]byte, 0, 64*1024), 4*1024*1024)
	for sc.Scan() {
		data, ok := strings.CutPrefix(sc.Text(), "data: ")
		if !ok || strings.TrimSpace(data) == "[DONE]" {
			continue
		}
		var chunk struct {
			Choices []struct {
				Delta struct {
					Content   string           `json:"content"`
					ToolCalls []map[string]any `json:"tool_calls"`
				} `json:"delta"`
				FinishReason string `json:"finish_reason"`
			} `json:"choices"`
			Usage *usageBlock `json:"usage"`
		}
		if json.Unmarshal([]byte(data), &chunk) != nil {
			continue
		}
		if chunk.Usage != nil {
			captured = chunk.Usage
		}
		if len(chunk.Choices) == 0 {
			continue
		}
		delta := chunk.Choices[0].Delta
		if delta.Content == "" && len(delta.ToolCalls) == 0 {
			continue
		}
		line := ollamaReply(clientModel, kind)
		if kind == "generate" {
			line["response"] = delta.Content
		} else {
			msg := map[string]any{"role": "assistant", "content": delta.Content}
			if len(delta.ToolCalls) > 0 {
				msg["tool_calls"] = delta.ToolCalls
			}
			line["message"] = msg
		}
		line["done"] = false
		if err := enc.Encode(line); err != nil {
			break
		}
		if flusher != nil {
			flusher.Flush()
		}
	}
	cost := record(name, model, captured, now)
	final := ollamaReply(clientModel, kind)
	if kind == "generate" {
		final["response"] = ""
	} else {
		final["message"] = map[string]any{"role": "assistant", "content": ""}
	}
	final["done"] = true
	final["done_reason"] = "stop"
	if captured != nil {
		final["prompt_eval_count"] = captured.PromptTokens
		final["eval_count"] = captured.CompletionTokens
	}
	final["total_duration"] = time.Since(now).Nanoseconds()
	_ = enc.Encode(final)
	if flusher != nil {
		flusher.Flush()
	}
	w.Header().Set("X-Router-Usd", fmt.Sprintf("%.6f", cost))
	return nil
}

func ollamaReply(clientModel, kind string) map[string]any {
	model := clientModel
	if model == "" {
		model = defaultServed()
	}
	if !strings.Contains(model, ":") {
		model += ":latest"
	}
	return map[string]any{
		"model":      model,
		"created_at": time.Now().UTC().Format(time.RFC3339Nano),
	}
}

func finishToOllama(reason string) string {
	switch reason {
	case "length":
		return "length"
	case "stop", "":
		return "stop"
	default:
		return reason
	}
}

func quoted(s string) string {
	if s == "" {
		return "(empty)"
	}
	return s
}

func handleOllamaShow(w http.ResponseWriter, r *http.Request) {
	var req struct {
		Model string `json:"model"`
		Name  string `json:"name"`
	}
	_ = json.NewDecoder(io.LimitReader(r.Body, 1<<16)).Decode(&req)
	want := req.Model
	if want == "" {
		want = req.Name
	}
	model, ok := resolveModel(want)
	if !ok {
		writeJSON(w, 404, map[string]any{"error": "model " + quoted(want) + " not found"})
		return
	}
	var by []string
	for name := range provs {
		if servesModel(name, model) {
			by = append(by, name)
		}
	}
	writeJSON(w, 200, map[string]any{
		"modelfile":  "# routed by offpeak-router; there is no local model file",
		"parameters": "",
		"template":   "",
		"details": map[string]any{
			"parent_model":       "", "format": "api", "family": modelAPI(model),
			"families":           by, "parameter_size": "", "quantization_level": "",
			"router_api": modelAPI(model), "router_providers": by,
		},
		"model_info": map[string]any{"router.owned_by": "offpeak-router"},
	})
}

// handleOllamaPs answers the "what is loaded in memory" question: nothing ever
// is, because every request goes straight to an upstream.
func handleOllamaPs(w http.ResponseWriter, _ *http.Request) {
	writeJSON(w, 200, map[string]any{"models": []any{}})
}

// logf keeps the failover logging style of the rest of the package.
var logf = defaultLogf

func defaultLogf(format string, args ...any) {
	_ = context.Background()
	fmt.Printf(format+"\n", args...)
}
